<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Register - eCitizen Portal</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 min-h-screen flex flex-col justify-between">
  <header class="bg-[#002244] text-white border-b-4 border-[#006633] p-4">
    <div class="max-w-6xl mx-auto flex justify-between items-center">
      <div class="flex items-center gap-3">
        <div class="bg-emerald-600 text-white font-bold p-2 rounded text-lg">eC</div>
        <div>
          <h1 class="font-bold text-lg leading-tight">eCitizen Portal</h1>
          <p class="text-xs text-gray-300">Republic of Kenya - Public Service Management</p>
        </div>
      </div>
    </div>
  </header>

  <main class="flex-grow flex items-center justify-center p-4">
    <div class="bg-white p-8 rounded-lg shadow-md border border-gray-200 w-full max-w-md">
      <div class="text-center mb-6">
        <h2 class="text-2xl font-bold text-[#002244]">Create Citizen Account</h2>
        <p class="text-sm text-gray-600 mt-1">Register to submit and track requests</p>
      </div>

      <% if (error) { %>
        <div class="bg-red-100 border border-red-400 text-red-700 text-xs p-3 rounded mb-4">
          <%= error %>
        </div>
      <% } %>

      <form action="/register" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Full Name</label>
          <input type="text" name="name" required placeholder="John Doe" class="w-full border p-2.5 rounded text-sm focus:ring-2 focus:ring-[#002244] outline-none">
        </div>
        <div>
          <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Email Address</label>
          <input type="email" name="email" required placeholder="john@example.com" class="w-full border p-2.5 rounded text-sm focus:ring-2 focus:ring-[#002244] outline-none">
        </div>
        <div>
          <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Password</label>
          <input type="password" name="password" required placeholder="••••••••" class="w-full border p-2.5 rounded text-sm focus:ring-2 focus:ring-[#002244] outline-none">
        </div>
        <button type="submit" class="w-full bg-[#006633] hover:bg-[#004d26] text-white font-semibold py-2.5 rounded text-sm shadow">
          Create Account
        </button>
      </form>

      <div class="mt-6 text-center text-xs text-gray-600 border-t pt-4">
        Already have an account? <a href="/login" class="text-[#002244] font-bold hover:underline">Sign In</a>
      </div>
    </div>
  </main>

  <footer class="bg-gray-800 text-gray-400 text-center py-3 text-xs">
    &copy; 2026 Republic of Kenya - Murang'a County ICT Portal
  </footer>
</body>
</html>